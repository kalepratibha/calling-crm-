# XAMPP defaults — MySQL user "root" with an EMPTY password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=calling_crm

PORT=5000
JWT_SECRET=change-this-to-a-long-random-text
APP_TZ=Asia/Kolkata
MIN_CALLS=6
SYNC_MINUTES=15

# ---- Login OTP (a new PC / browser / phone must be verified once) ----
# sms   = OTP is sent by SMS to the executive's own mobile number (Powerstext, needs SMS_AUTH_KEY)
# admin = OTP is shown to the admin in Admin panel -> Executives (no SMS needed)
# both  = SMS + shown to admin (also works as a fallback if the SMS fails)
OTP_MODE=sms
OTP_TTL_MIN=10
# true = admin logins also need the OTP on a new PC (the admin's login number must be a REAL mobile number then)
OTP_FOR_ADMIN=false

# ---- SMS gateway (Powerstext) ----
SMS_AUTH_KEY=
SMS_SENDER_ID=DSAENT
SMS_TEMPLATE_ID=1607100000000367692
SMS_ROUTE=1
# Must match your DLT-approved template exactly. {otp} is replaced by the code.
SMS_OTP_TEXT=Use this verification code {otp} to verify your mobile number on WealthFunds2x DE

# ---- Attendance ----
# Weekly off days: 0=Sunday ... 6=Saturday (comma separated, empty = none)
WEEKLY_OFF=0

DISTRIBUTION_CUTOFF_HOUR=12

# ---- Shared pool ----
# Interested clients whose account is not opened after this many days return to every executive's All Clients.
# POOL_RETURN_DAYS=10

# ---- OTP at every sign-in ----
# true = every executive sign-in asks the OTP (SMS to his mobile). false = only on a new PC / browser / phone.
# OTP_EVERY_LOGIN=true

# true = Not interested clients also appear in every executive's All Clients. Default false = only Call back + Not pickup (+ Interested after POOL_RETURN_DAYS).
# POOL_INCLUDE_NOT_INTERESTED=false
